# Copy to .env.local for local development. Never commit the filled-in file.

# Postgres (Neon). Use the POOLED connection string — the one whose host
# contains "-pooler" — so serverless functions do not exhaust connections.
DATABASE_URL="postgresql://user:password@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require"

# Comma-separated list of emails that get Super Admin (SaaS platform owner)
# access at /platform. This is the ONLY way to grant it — never the UI.
# Removing someone from this list revokes them on the next cold start.
PLATFORM_ADMIN_IDENTIFIERS="sps1590@gmail.com"

# Secret used to sign mobile device tracking tokens for the GPS telemetry
# API. Generate with: node -e "console.log(crypto.randomUUID()+crypto.randomUUID())"
TELEMETRY_TOKEN_SECRET="change-me-to-a-long-random-string"

# Optional. Public base URL, used in emails and the PWA manifest.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
